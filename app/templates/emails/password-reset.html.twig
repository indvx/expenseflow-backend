{% extends "emails/base.html.twig" %}

{% block title %}
Password Reset
{% endblock %}

{% block content %}

<h2>Hello {{ user_name }},</h2>

<p>
    You requested a password reset for your account.
    Your temporary password is: <strong>{{ temp_password }}</strong>
</p>

<p>
    Click the button below to login to your account and change your password.
</p>

<p>
    <a href="{{ login_url }}" class="btn">
        Login
    </a>
</p>

<p>
    If you did not request this reset, you can safely ignore this email.
</p>

<p>
    Thank you,
    The ExpenseFlow Team
</p>

{% endblock %}