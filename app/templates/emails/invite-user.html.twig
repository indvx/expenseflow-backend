{% extends "emails/base.html.twig" %}

{% block title %}
Project Invitation
{% endblock %}

{% block content %}

<h2>Hello {{ member_name }},</h2>

<p>
    You have been invited by <strong>{{ invited_by }}</strong>
    to join the project:
</p>

<div class="info-box">
    <strong>{{ project_name }}</strong>
</div>

<p>
    Click the button below to complete your registration and
    start collaborating with your team.
</p>

<p>
    <a href="{{ invitation_url }}" class="btn">
        Accept Invitation
    </a>
</p>

<p>
    If you did not expect this invitation, you can safely ignore this email.
</p>

{% endblock %}